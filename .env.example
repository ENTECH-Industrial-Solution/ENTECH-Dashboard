# Copy to .env.local for development. Never commit a filled-in copy.

# --- Database (Supabase) ------------------------------------------------------
# Find both strings in: Supabase dashboard > Project Settings > Database >
# Connection string. Replace [PASSWORD], [PROJECT-REF], and [REGION].
#
# `?schema=app` is REQUIRED on both. Prisma's tables live in the `app` schema,
# not `public`, so that Supabase's PostgREST API — which exposes `public` to the
# anon key — can never reach password hashes or session tokens.
# Run prisma/supabase-01-init.sql before the first migration to create it.

# Runtime: Transaction pooler (Supavisor, port 6543). Required on serverless —
# each function invocation would otherwise open its own direct connection and
# exhaust the database's connection limit.
#
# connection_limit is 5, not 1. One connection does bound what a lambda can hold
# open, but it also serialises the queries *inside a single request*: every
# Promise.all in the query layer queues behind the one connection. Measured, a
# batch of 8 queries took 3.8s at connection_limit=1 and 0.97s at 10.
#
# `pgbouncer=true` is required and must stay. It is expensive — it disables
# prepared statements and costs ~250ms per query — but without it transaction
# pooling hands consecutive queries to different server connections and they
# fail with `26000 prepared statement "sN" does not exist`. Measured: 1102 of
# 1200 queries failed with the flag removed.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&schema=app"

# Migrations: a non-pooled connection. Prisma migrate uses session-level
# constructs (advisory locks, prepared statements) that a transaction pooler
# cannot carry, so this must NOT point at port 6543.
#
# Setting DEV_DIRECT_DB=1 also runs the app itself through this connection in
# development — see below.
#
# Prefer the Session pooler below: Supabase's direct connection
# (db.[PROJECT-REF].supabase.co:5432) is IPv6-only unless the project has the
# IPv4 add-on, and most home/office networks cannot reach it.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=app"

# Optional, development only. Runs the app through DIRECT_URL instead of the
# pooler. Worth real time — the admin dashboard measured a median of 2598ms
# through the pooler and 926ms direct — because session mode needs no
# `pgbouncer=true` and so keeps prepared statements.
#
# Off by default: session mode's pool is small and shared with Prisma Studio and
# migrations, and when it runs out Supavisor refuses the connection outright.
# That surfaces as `P1001 Can't reach database server`, which reads like an
# outage rather than a full pool. If you turn this on and see P1001, turn it off.
# Never set it in production — session mode cannot carry serverless traffic.
# DEV_DIRECT_DB="1"

# --- Application --------------------------------------------------------------
# Canonical origin. Must match the deployed URL exactly in production.
APP_URL="http://localhost:3000"

# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# --- Bootstrap admin (used only by `npm run db:seed`) --------------------------
# Remove these from the environment after the first seed.
# Never set these in the production host.
SEED_ADMIN_CODE="ENT-0001"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD="change-this-on-first-login"

# --- NOT used by this app -----------------------------------------------------
# This project does not use Supabase Auth, Storage, or the JS client, so it needs
# no SUPABASE_URL, anon key, or service_role key. If you add a Supabase feature
# later, remember the service_role key bypasses RLS entirely — it must never
# reach the browser or a NEXT_PUBLIC_* variable.
