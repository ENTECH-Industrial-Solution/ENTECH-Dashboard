# Copy to .env.local for development. Never commit a filled-in copy.

# --- Database -----------------------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection used by prisma migrate. Neon and Supabase both
# expose one; if your provider does not, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Application --------------------------------------------------------------
# Canonical origin. Must match the deployed URL exactly in production.
APP_URL="http://localhost:3000"

# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# --- Bootstrap admin (used only by `npm run db:seed`) --------------------------
# Remove these from the environment after the first seed.
SEED_ADMIN_CODE="ENT-0001"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD="change-this-on-first-login"
