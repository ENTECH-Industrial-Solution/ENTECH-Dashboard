// ENTECH Dashboard — data model
//
// Design rules that the rest of the codebase depends on:
//  1. Employees are never hard-deleted. Deactivating preserves the task history
//     that the completed-task archive exists to prove.
//  2. TaskEvent and AuditLog are append-only. No update/delete paths are exposed
//     anywhere in the application layer.
//  3. Every mutation that matters is written together with its audit row in the
//     same transaction, so evidence cannot silently drift from state.

generator client {
  provider = "prisma-client-js"

  /// The build machine and the runtime are different Linux distributions:
  /// Vercel builds on Ubuntu (debian-openssl-*) but its functions execute on
  /// AWS Lambda (Amazon Linux, rhel-openssl-*). "native" alone would ship an
  /// engine the runtime cannot load, and the failure only shows up on the first
  /// query in production. Both rhel targets are listed because the exact one
  /// depends on the Lambda Node version (20+ -> AL2023 -> 3.0.x).
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  UPDATED
  COMMENTED
  COMPLETED
  REOPENED
}

model Employee {
  id String @id @default(cuid())

  /// Human-facing staff code issued by an admin (e.g. "ENT-0042").
  /// This is the login identifier — never the database id.
  employeeCode String @unique
  fullName     String
  email        String? @unique
  department   String?
  position     String?
  role         Role    @default(EMPLOYEE)

  /// Argon2id hash. The plaintext password never leaves the server action.
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  passwordChangedAt  DateTime @default(now())

  /// Soft-delete. Deactivated accounts keep their history but cannot log in.
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  /// Brute-force protection state, enforced in lib/auth/login-throttle.ts
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById      String?
  createdBy        Employee?  @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdEmployees Employee[] @relation("EmployeeCreatedBy")

  sessions          Session[]
  assignedTasks     Task[]      @relation("TaskAssignee")
  createdTasks      Task[]      @relation("TaskCreator")
  fieldTrips        FieldTrip[] @relation("FieldTripTraveller")
  createdFieldTrips FieldTrip[] @relation("FieldTripCreator")
  taskEvents        TaskEvent[]
  auditLogs         AuditLog[]

  @@index([isActive, role])
  @@index([department])
}

model Session {
  id String @id @default(cuid())

  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// user's httpOnly cookie, so a database leak cannot be replayed as a login.
  tokenHash String @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  /// Hard ceiling regardless of activity.
  expiresAt DateTime
  /// Rolling window; refreshed on use, enforced on every request.
  idleExpiresAt DateTime
  revokedAt     DateTime?

  createdAt      DateTime @default(now())
  lastActiveAt   DateTime @default(now())

  @@index([employeeId, revokedAt])
  @@index([expiresAt])
}

model Task {
  id String @id @default(cuid())

  /// Sequential human-readable reference, e.g. "TSK-000123".
  code        String       @unique
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId String
  assignee   Employee @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   Employee @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Planned schedule, chosen by the admin when assigning the work.
  /// startDate is the planned beginning and dueDate the planned end; they are
  /// distinct from startedAt/completedAt, which record what actually happened.
  startDate DateTime?
  dueDate   DateTime?
  startedAt DateTime?

  /// Set once, when status first becomes COMPLETED. Together with the
  /// TaskEvent trail this is the "evidence" record the archive tab shows.
  completedAt    DateTime?
  completionNote String?
  proofUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TaskEvent[]

  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([completedAt])
}

/// Append-only history for a single task. Written inside the same transaction
/// as the task mutation it describes.
model TaskEvent {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId String?
  actor   Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so the trail stays readable even if the actor is removed.
  actorLabel String

  type       TaskEventType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  note       String?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Append-only security/admin trail: logins, employee provisioning, role
/// changes, deactivations. Never updated, never deleted by application code.
model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised actor description, survives actor removal.
  actorLabel String

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/// Single-row table backing the TSK-###### sequence.
model Counter {
  name  String @id
  value Int    @default(0)
}

/// A planned trip off-site: who is going, where, and on which days.
///
/// The day range is inclusive and interpreted in Asia/Bangkok, so a trip from
/// the 3rd to the 5th occupies all three cells in the calendar.
///
/// Location is stored as a name plus optional coordinates rather than an
/// embedded map. The CSP forbids third-party frames and the app has no Google
/// API key, so the UI links out to Google Maps with the pin instead of
/// embedding one — see src/lib/maps.ts for how the link is built.
///
/// A trip is scheduled by an admin but *run* by the person on it: starting and
/// completing one is the traveller reporting from the field, so those two are
/// the only writes an employee may make (see canRunFieldTrip in auth/rbac.ts).
/// Nothing here is ever deleted — a trip ends up cancelled or completed, and
/// either way the row stays as the record of what happened.
model FieldTrip {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation("FieldTripTraveller", fields: [employeeId], references: [id], onDelete: Restrict)

  purpose      String
  locationName String
  address      String?
  latitude     Float?
  longitude    Float?

  /// A pasted Google Maps place link, for when it is more precise than a name
  /// search. Only Google Maps hosts pass validation before this is stored.
  mapUrl String?

  startDate DateTime
  endDate   DateTime

  note String?

  /// What actually happened, written from the field by the traveller (or an
  /// admin) rather than planned in advance. startDate/endDate are the days the
  /// trip was scheduled for; these two are when it really began and ended —
  /// the same split Task draws between dueDate and completedAt.
  startedAt   DateTime?
  completedAt DateTime?

  /// The report filed when the trip was closed out. Both are optional: the
  /// evidence a trip leaves is that someone was there on those days, so a link
  /// is offered rather than demanded. Once written they are permanent — a
  /// completed trip refuses further edits and cannot be cancelled.
  completionNote String?
  proofUrl       String?

  /// Trips are cancelled, not deleted: people plan around them, so the record
  /// of a cancellation is more useful than a silent disappearance.
  cancelledAt     DateTime?
  cancelledReason String?

  createdById String
  createdBy   Employee @relation("FieldTripCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([startDate, endDate])
}

/// Admin-controlled switches for what the task UI shows.
///
/// Key-value rather than a column per switch, so adding a toggle is a code
/// change with a default (src/lib/settings/settings.ts) rather than a
/// migration. A row exists only where an admin has overridden the default,
/// which also means a fresh database behaves exactly like the defaults.
///
/// Changes are written with an AuditLog row, like every other admin action.
model AppSetting {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
}
