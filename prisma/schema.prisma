// ENTECH Dashboard — data model
//
// Design rules that the rest of the codebase depends on:
//  1. Employees are deactivated, not deleted, wherever they have history.
//     Deactivating preserves the task history the completed-task archive exists
//     to prove. deleteEmployeeAction can remove an account outright, but only
//     one that is already deactivated and that no task, trip, or event still
//     references — the Restrict foreign keys below are what make that
//     enforceable rather than a convention.
//  2. TaskEvent and AuditLog are append-only. No update/delete paths are exposed
//     anywhere in the application layer.
//  3. Every mutation that matters is written together with its audit row in the
//     same transaction, so evidence cannot silently drift from state.

generator client {
  provider = "prisma-client-js"

  /// The build machine and the runtime are different Linux distributions:
  /// Vercel builds on Ubuntu (debian-openssl-*) but its functions execute on
  /// AWS Lambda (Amazon Linux, rhel-openssl-*). "native" alone would ship an
  /// engine the runtime cannot load, and the failure only shows up on the first
  /// query in production. Both rhel targets are listed because the exact one
  /// depends on the Lambda Node version (20+ -> AL2023 -> 3.0.x).
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  UPDATED
  COMMENTED
  COMPLETED
  REOPENED
}

model Employee {
  id String @id @default(cuid())

  /// Human-facing staff code issued by an admin (e.g. "ENT-0042").
  /// This is the login identifier — never the database id. An admin may change
  /// it (updateEmployeeAction); sessions are keyed on the row id, so a rename
  /// changes what the person types at the login form and nothing else.
  employeeCode String  @unique
  fullName     String
  email        String? @unique
  department   String?
  position     String?
  role         Role    @default(EMPLOYEE)

  /// Argon2id hash. The plaintext password never leaves the server action.
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  passwordChangedAt  DateTime @default(now())

  /// Soft-delete, and the normal end of an account: a deactivated row keeps its
  /// history but cannot log in. It is also the precondition for the hard
  /// delete — an active account cannot be removed at all.
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  /// Brute-force protection state, enforced in lib/auth/login-throttle.ts
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById      String?
  createdBy        Employee?  @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdEmployees Employee[] @relation("EmployeeCreatedBy")

  sessions          Session[]
  assignedTasks     Task[]      @relation("TaskAssignee")
  createdTasks      Task[]      @relation("TaskCreator")
  fieldTrips        FieldTrip[] @relation("FieldTripTraveller")
  createdFieldTrips FieldTrip[] @relation("FieldTripCreator")
  taskEvents        TaskEvent[]
  auditLogs         AuditLog[]

  /// The two Restrict sides are counted by deleteEmployeeAction, so a pin or a
  /// lead somebody filed keeps their account alive exactly as a task does.
  /// ownedCustomers is not: it is SetNull, so a lead can be left behind.
  createdCustomerPins CustomerPin[] @relation("CustomerPinCreator")
  createdCustomers    Customer[]    @relation("CustomerCreator")
  ownedCustomers      Customer[]    @relation("CustomerOwner")

  @@index([isActive, role])
  @@index([department])
}

model Session {
  id String @id @default(cuid())

  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// user's httpOnly cookie, so a database leak cannot be replayed as a login.
  tokenHash String @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  /// Hard ceiling regardless of activity.
  expiresAt     DateTime
  /// Rolling window; refreshed on use, enforced on every request.
  idleExpiresAt DateTime
  revokedAt     DateTime?

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([employeeId, revokedAt])
  @@index([expiresAt])
}

model Task {
  id String @id @default(cuid())

  /// Sequential human-readable reference, e.g. "TSK-000123".
  code        String       @unique
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId String
  assignee   Employee @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   Employee @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Planned schedule, chosen by the admin when assigning the work.
  /// startDate is the planned beginning and dueDate the planned end; they are
  /// distinct from startedAt/completedAt, which record what actually happened.
  startDate DateTime?
  dueDate   DateTime?
  startedAt DateTime?

  /// Set once, when status first becomes COMPLETED. Together with the
  /// TaskEvent trail this is the "evidence" record the archive tab shows.
  completedAt    DateTime?
  completionNote String?
  proofUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TaskEvent[]

  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([completedAt])
}

/// Append-only history for a single task. Written inside the same transaction
/// as the task mutation it describes.
model TaskEvent {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId    String?
  actor      Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so the trail stays readable even if the actor is removed.
  actorLabel String

  type       TaskEventType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  note       String?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Append-only security/admin trail: logins, employee provisioning, role
/// changes, deactivations. Never updated, never deleted by application code.
model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actor      Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised actor description, survives actor removal.
  actorLabel String

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/// Single-row table backing the TSK-###### sequence.
model Counter {
  name  String @id
  value Int    @default(0)
}

/// A planned trip off-site: who is going, where, and on which days.
///
/// The day range is inclusive and interpreted in Asia/Bangkok, so a trip from
/// the 3rd to the 5th occupies all three cells in the calendar.
///
/// Location is stored as a name plus optional coordinates rather than an
/// embedded map. The CSP forbids third-party frames and the app has no Google
/// API key, so the UI links out to Google Maps with the pin instead of
/// embedding one — see src/lib/maps.ts for how the link is built.
///
/// A trip is scheduled by an admin but *run* by the person on it: starting and
/// completing one is the traveller reporting from the field, so those two are
/// the only writes an employee may make (see canRunFieldTrip in auth/rbac.ts).
/// Nothing here is ever deleted — a trip ends up cancelled or completed, and
/// either way the row stays as the record of what happened.
model FieldTrip {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation("FieldTripTraveller", fields: [employeeId], references: [id], onDelete: Restrict)

  purpose      String
  locationName String
  address      String?
  latitude     Float?
  longitude    Float?

  /// The place on the customer map this trip goes to, when it is one.
  ///
  /// Optional, and it always will be: plenty of trips go somewhere that is not
  /// a prospect — a supplier, a training day, a site the company already owns.
  /// The link is what makes "we have been to this pin four times" answerable
  /// from either end.
  ///
  /// SetNull rather than Restrict or Cascade, and both of the others would be
  /// wrong. A trip is never deleted, so Cascade would let a pin delete history;
  /// Restrict would make a pin undeletable because somebody once drove there.
  /// The trip keeps its own locationName and coordinates either way — the link
  /// is a convenience, not the trip's record of where it went — so losing it
  /// costs the trip nothing but the cross-reference.
  pinId String?
  pin   CustomerPin? @relation("FieldTripPin", fields: [pinId], references: [id], onDelete: SetNull)

  /// A pasted Google Maps place link, for when it is more precise than a name
  /// search. Only Google Maps hosts pass validation before this is stored.
  mapUrl String?

  startDate DateTime
  endDate   DateTime

  /// Departure and return, as "HH:MM" in Asia/Bangkok, or null for the office
  /// hours in src/lib/calendar.ts.
  ///
  /// Deliberately not folded into startDate/endDate, which stay pure Bangkok
  /// calendar days: the whole calendar buckets on them through dayStart() and
  /// bangkokDayKey(), and the upcoming/past split compares them against a day
  /// boundary. Giving those a time of day would quietly move a trip between
  /// days. Null rather than a stored default, so a fresh row means "nobody
  /// said" and the default can change without a migration.
  startTime String?
  endTime   String?

  note String?

  /// What actually happened, written from the field by the traveller (or an
  /// admin) rather than planned in advance. startDate/endDate are the days the
  /// trip was scheduled for; these two are when it really began and ended —
  /// the same split Task draws between dueDate and completedAt.
  startedAt   DateTime?
  completedAt DateTime?

  /// The report filed when the trip was closed out. Both are optional: the
  /// evidence a trip leaves is that someone was there on those days, so a link
  /// is offered rather than demanded. Once written they are permanent — a
  /// completed trip refuses further edits and cannot be cancelled.
  completionNote String?
  proofUrl       String?

  /// Trips are cancelled, not deleted: people plan around them, so the record
  /// of a cancellation is more useful than a silent disappearance.
  cancelledAt     DateTime?
  cancelledReason String?

  createdById String
  createdBy   Employee @relation("FieldTripCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([startDate, endDate])
  @@index([pinId])
}

/// Admin-controlled switches for what the task UI shows.
///
/// Key-value rather than a column per switch, so adding a toggle is a code
/// change with a default (src/lib/settings/settings.ts) rather than a
/// migration. A row exists only where an admin has overridden the default,
/// which also means a fresh database behaves exactly like the defaults.
///
/// Changes are written with an AuditLog row, like every other admin action.
model AppSetting {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
}

/// How warm a lead is, at the moment somebody last looked.
///
/// Five values rather than a free-text field: the whole point of the map is
/// that a colour tells you where the week's calls should go, and a colour can
/// only be derived from a closed set. Order is deliberate — it runs from
/// warmest to coldest, and CUSTOMER_STATUS_ORDER in src/lib/customers.ts
/// depends on it to decide which status a stacked pin wears.
enum CustomerStatus {
  /// สนใจ — wants to hear more.
  INTERESTED
  /// ลังเล — interested but not committing.
  CONSIDERING
  /// ยังไม่เอา — said no for now. Not deleted: a no this quarter is a lead
  /// next quarter, and the note explaining it is the reason to come back.
  NOT_INTERESTED
  /// ปิดการขายแล้ว — bought. The terminal good end.
  WON
  /// ติดต่อไม่ได้ — nobody picks up. Distinct from NOT_INTERESTED, which is an
  /// answer; this is the absence of one.
  UNREACHABLE
}

/// How a lead reached us.
///
/// A closed set, for the same reason CustomerStatus is one: marketing's
/// question is "how many came in through each channel this month", and a
/// free-text field answers it with forty spellings of "อีเมล". The five
/// ENQUIRY_*/EVENT/REFERRAL values are all *inbound* — somebody came to us —
/// and FIELD_VISIT is the one that is not; isInboundSource() in
/// src/lib/customers.ts is the one place that split is expressed.
///
/// FIELD_VISIT is the default because it is what every row predating this
/// column actually was: a pin dropped by somebody standing in the street.
enum CustomerSource {
  /// ออกไปเจอเอง — found on a visit, which is what the map was built for.
  FIELD_VISIT
  /// อีเมลเข้ามา
  ENQUIRY_EMAIL
  /// โทรเข้ามา
  ENQUIRY_PHONE
  /// ทัก LINE เข้ามา
  ENQUIRY_LINE
  /// กรอกฟอร์ม/เว็บไซต์
  ENQUIRY_WEB
  /// เจอกันที่งานอีเวนต์ ออกบูธ สัมมนา
  EVENT
  /// มีคนแนะนำต่อ
  REFERRAL
}

/// A point on the map, and the customers standing at it.
///
/// Split from Customer on purpose: one address routinely holds several
/// businesses — a floor of an office block, a row of shophouses — and drawing
/// one marker per company puts three pins on the same pixel where none of them
/// can be clicked. So the pin owns the place and the customers stack inside it,
/// which is also the shape the person doing the visit thinks in: they go to a
/// building, not to a record.
///
/// Coordinates are required and are the identity of the row. A pin with no
/// point is not a pin; the name and address are labels on it.
///
/// Unlike FieldTrip, both are non-null: this row exists *because* somebody
/// clicked a spot on the map, so there is no "location known only by name"
/// case to model.
model CustomerPin {
  id String @id @default(cuid())

  /// What the place is called — a building, an estate, an industrial park.
  /// Optional: a pin dropped for one shop is adequately named by the customer
  /// inside it, and demanding a second name would just get the first one typed
  /// twice.
  label   String?
  address String?

  latitude  Float
  longitude Float

  createdById String
  createdBy   Employee @relation("CustomerPinCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade, and it is the one place in this schema that deletes children.
  /// A pin is the place; deleting it is saying the place is not a place any
  /// more, and leaving the customers behind would strand rows with no point on
  /// the map to draw them at. deleteCustomerPinAction snapshots every one of
  /// them into the audit row first, in the same transaction — the same bargain
  /// deleteTaskAction strikes with TaskEvent.
  customers Customer[]

  /// The trips that went here. SetNull on the other side, so deleting a pin
  /// unlinks them rather than taking them with it — see FieldTrip.pinId.
  fieldTrips FieldTrip[] @relation("FieldTripPin")

  @@index([latitude, longitude])
}

/// One prospect at a pin.
///
/// Everything here is somebody's note about a conversation, so nothing is
/// required beyond the name and the status. A sales pin filled in from the car
/// park gets a name and a colour; the rest arrives later or not at all.
model Customer {
  id String @id @default(cuid())

  pinId String
  pin   CustomerPin @relation(fields: [pinId], references: [id], onDelete: Cascade)

  name   String
  status CustomerStatus @default(CONSIDERING)

  /// How this lead reached us. Defaulted rather than required, so every row
  /// written before the column existed keeps saying what it was — a pin
  /// dropped in the field.
  source CustomerSource @default(FIELD_VISIT)

  contactName String?
  phone       String?
  email       String?
  lineId      String?
  note        String?

  /// The employee following this lead. Nullable and SetNull rather than
  /// Restrict: an unclaimed lead is a real state, and an account that leaves
  /// should not be undeletable because a lead still names it. What the person
  /// did survives them in the audit trail, which is where it belongs.
  ownerId String?
  owner   Employee? @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// When this lead first reached us, or we first reached them. Nullable, and
  /// filled in from createdAt at display time: null means nobody said, which
  /// is not the same as "the day the row was typed" — an enquiry that arrived
  /// on Monday is often entered on Thursday, and marketing counts the Monday.
  firstContactedAt DateTime?

  /// When somebody last spoke to them. Written by whoever files the update,
  /// not by the system — "we called on Tuesday" is a fact about the world, and
  /// updatedAt is a fact about this row.
  lastContactedAt DateTime?

  createdById String
  createdBy   Employee @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinId])
  @@index([status])
  @@index([source])
  @@index([ownerId])
}
